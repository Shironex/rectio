{
  "name": "@rectio/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The rectio CLI: init a project, add components, blocks and themes from the rectio registry, diff them against upstream.",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "rectio": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rectio/registry": "workspace:*",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  }
}
