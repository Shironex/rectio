{
  "name": "@rectio/site",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The rectio docs site and landing page: Fumadocs on Next.js, built as static files.",
  "scripts": {
    "dev": "node scripts/templates.ts && next dev",
    "build": "node scripts/templates.ts && next build",
    "typecheck": "node scripts/templates.ts && next typegen && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "preview": "node scripts/serve.ts",
    "shoot": "node scripts/shoot.ts",
    "templates": "node scripts/templates.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rectio/blocks": "workspace:*",
    "@rectio/motion": "workspace:*",
    "@rectio/registry": "workspace:*",
    "@rectio/tokens": "workspace:*",
    "@rectio/ui": "workspace:*",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5"
  }
}
