{
  "$description": "Dense skin, applied with data-skin=\"dense\". A smaller type scale, tighter line heights, smaller corners and a slightly tighter rhythm for data-heavy apps. Compact density still applies on top of it.",
  "font": {
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.71875,
          "unit": "rem"
        },
        "$description": "11.5px: captions and axis labels stay legible at the dense scale."
      },
      "sm": {
        "$value": "{font-size.12}"
      },
      "base": {
        "$value": "{font-size.13}"
      },
      "lg": {
        "$value": "{font-size.14}"
      },
      "xl": {
        "$value": "{font-size.16}"
      },
      "2xl": {
        "$value": "{font-size.20}"
      },
      "3xl": {
        "$value": "{font-size.24}"
      },
      "4xl": {
        "$value": "{font-size.32}"
      },
      "5xl": {
        "$value": "{font-size.44}"
      }
    },
    "line-height": {
      "$type": "number",
      "xs": {
        "$value": 1.273
      },
      "sm": {
        "$value": 1.333
      },
      "base": {
        "$value": 1.385
      },
      "lg": {
        "$value": 1.429
      },
      "xl": {
        "$value": 1.375
      },
      "2xl": {
        "$value": 1.3
      },
      "3xl": {
        "$value": 1.25
      },
      "4xl": {
        "$value": 1.125
      },
      "5xl": {
        "$value": 1.09
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{size.3}"
    },
    "panel": {
      "$value": "{size.6}"
    },
    "badge": {
      "$value": "{size.2}"
    }
  },
  "space": {
    "$type": "dimension",
    "unit": {
      "$value": {
        "value": 0.225,
        "unit": "rem"
      },
      "$description": "Between the default unit and compact density, so compact inside a dense app still tightens."
    }
  },
  "control": {
    "$type": "dimension",
    "height": {
      "sm": {
        "$value": "{size.26}"
      },
      "md": {
        "$value": "{size.32}"
      },
      "lg": {
        "$value": "{size.38}"
      }
    },
    "padding-x": {
      "sm": {
        "$value": "{size.8}"
      },
      "md": {
        "$value": "{size.12}"
      },
      "lg": {
        "$value": "{size.16}"
      }
    }
  }
}
