{
  "name": "@rectio/tokens",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "style-dictionary": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.0",
    "vitest": "^5.1.0"
  },
  "description": "Design tokens for rectio: DTCG sources, CSS variables and a Tailwind v4 theme.",
  "files": [
    "dist",
    "src",
    "generator",
    "scripts"
  ],
  "exports": {
    "./themes.css": "./dist/themes.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./generator": "./generator/index.ts",
    "./generator.json": "./dist/generator.json"
  },
  "scripts": {
    "build": "node scripts/build.ts && node scripts/generator-data.ts",
    "contrast": "node scripts/contrast.ts",
    "derive": "node scripts/derive.ts",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json"
  }
}
