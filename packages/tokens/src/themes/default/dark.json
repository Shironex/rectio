{
  "surface": {
    "$type": "color",
    "canvas": {
      "$value": "{palette.stone.1000}"
    },
    "default": {
      "$value": "{palette.stone.975}"
    },
    "raised": {
      "$value": "{palette.stone.950}"
    },
    "sunken": {
      "$value": "{palette.stone.1000}"
    },
    "overlay": {
      "$value": "{palette.stone.925}"
    },
    "hover": {
      "$value": "{palette.stone.925}"
    },
    "selected": {
      "$value": "{palette.cobalt.950}"
    },
    "inset": {
      "$value": "{palette.stone.900}",
      "$description": "A band inside an overlay, such as a dialog footer. Sits above the overlay in dark mode, below it in light."
    },
    "placeholder": {
      "$value": "{palette.stone.850}",
      "$description": "A skeleton shape or the empty track of a bar, ring or gauge: one step off the surface it sits on, lighter in dark mode, darker in light."
    },
    "placeholder-shine": {
      "$value": "{palette.stone.700}",
      "$description": "The light that sweeps across a skeleton shape."
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{palette.stone.50}"
    },
    "muted": {
      "$value": "{palette.stone.300}"
    },
    "subtle": {
      "$value": "{palette.stone.400}"
    },
    "disabled": {
      "$value": "{palette.stone.500}"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{palette.stone.850}"
    },
    "strong": {
      "$value": "{palette.stone.600}"
    }
  },
  "accent": {
    "$type": "color",
    "default": {
      "$value": "{palette.cobalt.600}"
    },
    "hover": {
      "$value": "{palette.cobalt.700}"
    },
    "active": {
      "$value": "{palette.cobalt.800}"
    },
    "subtle": {
      "$value": "{palette.cobalt.850}"
    },
    "strong": {
      "$value": "{palette.cobalt.300}"
    },
    "contrast": {
      "$value": "{palette.stone.0}"
    }
  },
  "positive": {
    "$type": "color",
    "default": {
      "$value": "{palette.green.600}"
    },
    "subtle": {
      "$value": "{palette.green.900}"
    },
    "strong": {
      "$value": "{palette.green.300}"
    },
    "contrast": {
      "$value": "{palette.stone.0}"
    }
  },
  "negative": {
    "$type": "color",
    "default": {
      "$value": "{palette.red.600}"
    },
    "hover": {
      "$value": "{palette.red.700}"
    },
    "subtle": {
      "$value": "{palette.red.900}"
    },
    "strong": {
      "$value": "{palette.red.300}"
    },
    "contrast": {
      "$value": "{palette.stone.0}"
    }
  },
  "warning": {
    "$type": "color",
    "default": {
      "$value": "{palette.amber.400}"
    },
    "subtle": {
      "$value": "{palette.amber.900}"
    },
    "strong": {
      "$value": "{palette.amber.300}"
    },
    "contrast": {
      "$value": "{palette.stone.975}"
    }
  },
  "info": {
    "$type": "color",
    "default": {
      "$value": "{palette.sky.600}"
    },
    "subtle": {
      "$value": "{palette.sky.900}"
    },
    "strong": {
      "$value": "{palette.sky.300}"
    },
    "contrast": {
      "$value": "{palette.stone.0}"
    }
  },
  "focus": {
    "$type": "color",
    "default": {
      "$value": "{palette.cobalt.400}"
    }
  },
  "scrim": {
    "$type": "color",
    "default": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.1, 0.005, 75],
        "alpha": 0.6
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.1, 0.01, 75],
            "alpha": 0.4
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.98, 0.01, 75],
            "alpha": 0.06
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 1,
            "unit": "px"
          }
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.1, 0.01, 75],
            "alpha": 0.35
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.1, 0.01, 75],
            "alpha": 0.6
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 20,
            "unit": "px"
          },
          "blur": {
            "value": 48,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          }
        }
      ]
    }
  },
  "chart": {
    "$type": "color",
    "$description": "Data visualisation. Series and sequence marks hold 3:1 against the surface and stay apart under protan, deutan and tritan vision; a legend, label or table always names them too.",
    "series": {
      "1": {
        "$value": "{palette.cobalt.400}",
        "$description": "First series, such as inflow or actual."
      },
      "2": {
        "$value": "{palette.orange.400}",
        "$description": "Second series, such as outflow. Blue against orange stays apart for every common colour vision type."
      },
      "3": {
        "$value": "{palette.stone.100}",
        "$description": "A line over bars, such as net cash flow. Drawn with a halo so it reads over either series."
      }
    },
    "sequence": {
      "1": {
        "$value": "{palette.cobalt.400}",
        "$description": "Ordered steps, such as aging buckets from current to 90+ days. Step 1 is the calm state."
      },
      "2": {
        "$value": "{palette.heat.on-dark-1}"
      },
      "3": {
        "$value": "{palette.heat.on-dark-2}"
      },
      "4": {
        "$value": "{palette.heat.on-dark-3}"
      },
      "5": {
        "$value": "{palette.heat.on-dark-4}",
        "$description": "The most severe step, such as over 90 days past due: deepest in light mode, the most saturated in dark."
      }
    },
    "grid": {
      "$value": "{palette.stone.900}",
      "$description": "Gridlines: quiet, behind the data."
    },
    "axis": {
      "$value": "{palette.stone.400}",
      "$description": "Axis labels and ticks."
    },
    "baseline": {
      "$value": "{palette.stone.600}",
      "$description": "The zero line."
    },
    "reference": {
      "$value": "{palette.stone.500}",
      "$description": "A target or budget mark that the data is measured against."
    },
    "tooltip": {
      "$value": "{palette.stone.925}",
      "$description": "Tooltip background."
    },
    "tooltip-border": {
      "$value": "{palette.stone.800}"
    },
    "halo": {
      "$value": "{palette.stone.975}",
      "$description": "Outline under a line or label so it stays readable over marks; the surface colour."
    }
  },
  "identity": {
    "$type": "color",
    "$description": "Identity tints for avatars and initials: decorative, never a state. A name always picks the same tint. Each pair keeps strong text readable on its subtle fill.",
    "1": {
      "subtle": {
        "$value": "{palette.cobalt.850}"
      },
      "strong": {
        "$value": "{palette.cobalt.200}"
      }
    },
    "2": {
      "subtle": {
        "$value": "{palette.green.850}"
      },
      "strong": {
        "$value": "{palette.green.200}"
      }
    },
    "3": {
      "subtle": {
        "$value": "{palette.amber.850}"
      },
      "strong": {
        "$value": "{palette.amber.200}"
      }
    },
    "4": {
      "subtle": {
        "$value": "{palette.sky.850}"
      },
      "strong": {
        "$value": "{palette.sky.200}"
      }
    },
    "5": {
      "subtle": {
        "$value": "{palette.orange.850}"
      },
      "strong": {
        "$value": "{palette.orange.200}"
      }
    },
    "6": {
      "subtle": {
        "$value": "{palette.citron.850}"
      },
      "strong": {
        "$value": "{palette.citron.200}"
      }
    }
  },
  "code": {
    "$type": "color",
    "$description": "Syntax highlighting, read by a build-time highlighter through CSS variables (--rx-code-token-*). Every token colour holds 4.5:1 against the code background.",
    "background": {
      "$value": "{palette.stone.950}",
      "$description": "Code blocks and their tabs."
    },
    "foreground": {
      "$value": "{palette.stone.50}",
      "$description": "Code text without a token colour."
    },
    "highlight": {
      "$value": "{palette.cobalt.950}",
      "$description": "A highlighted line."
    },
    "inserted": {
      "$value": "{palette.green.975}",
      "$description": "A line a diff adds."
    },
    "deleted": {
      "$value": "{palette.red.975}",
      "$description": "A line a diff removes."
    },
    "inserted-mark": {
      "$value": "{palette.green.300}",
      "$description": "The + of an added line."
    },
    "deleted-mark": {
      "$value": "{palette.red.300}",
      "$description": "The - of a removed line."
    },
    "line-number": {
      "$value": "{palette.stone.400}",
      "$description": "Line numbers in the gutter."
    },
    "token": {
      "keyword": {
        "$value": "{palette.cobalt.300}"
      },
      "string": {
        "$value": "{palette.green.300}"
      },
      "function": {
        "$value": "{palette.orange.300}"
      },
      "constant": {
        "$value": "{palette.sky.300}"
      },
      "parameter": {
        "$value": "{palette.amber.300}"
      },
      "comment": {
        "$value": "{palette.stone.400}"
      },
      "punctuation": {
        "$value": "{palette.stone.300}"
      },
      "string-expression": {
        "$value": "{palette.green.300}"
      },
      "link": {
        "$value": "{palette.cobalt.300}"
      }
    }
  }
}
