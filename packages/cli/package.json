{
  "name": "@rectio/cli",
  "version": "0.1.1",
  "description": "The rectio CLI: set up a React project, add components, blocks and themes from the rectio registry, and diff them against upstream. Includes a read-only MCP server.",
  "keywords": [
    "rectio",
    "cli",
    "react",
    "tailwindcss",
    "components",
    "ui",
    "design-system",
    "registry",
    "mcp",
    "finance"
  ],
  "homepage": "https://shironex.github.io/rectio/",
  "bugs": {
    "url": "https://github.com/Shironex/rectio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shironex/rectio.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Shironex",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "rectio": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rectio/registry": "workspace:*",
    "@rectio/tokens": "workspace:*",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  }
}
