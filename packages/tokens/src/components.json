{
  "component": {
    "$description": "Component tokens (tier 3): knobs a theme may turn for one component. They alias semantic tokens by default.",
    "button": {
      "height": {
        "$type": "dimension",
        "sm": {
          "$value": "{control.height.sm}"
        },
        "md": {
          "$value": "{control.height.md}"
        },
        "lg": {
          "$value": "{control.height.lg}"
        }
      },
      "padding-x": {
        "$type": "dimension",
        "sm": {
          "$value": "{control.padding-x.sm}"
        },
        "md": {
          "$value": "{control.padding-x.md}"
        },
        "lg": {
          "$value": "{control.padding-x.lg}"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": "{font.tracking.normal}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{size.10}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "background": {
        "$type": "color",
        "$value": "{surface.default}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.strong}"
      }
    },
    "popover": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      },
      "width": {
        "$type": "dimension",
        "$value": "{size.480}"
      },
      "footer-background": {
        "$type": "color",
        "$value": "{surface.inset}"
      }
    },
    "money": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.numeric}"
      }
    },
    "table": {
      "row-height": {
        "$type": "dimension",
        "$value": "{control.height.lg}",
        "$description": "Minimum height of a body row. Follows density."
      },
      "header-height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "cell-padding-x": {
        "$type": "dimension",
        "$value": "{control.padding-x.md}"
      },
      "header-background": {
        "$type": "color",
        "$value": "{surface.canvas}",
        "$description": "Behind a sticky header, so rows scroll under an opaque band. Match it to the surface the table sits on."
      },
      "row-selected": {
        "$type": "color",
        "$value": "{surface.selected}"
      }
    },
    "calendar": {
      "day-size": {
        "$type": "dimension",
        "$value": "{control.height.md}",
        "$description": "Width and height of a day button. Follows density."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.badge}"
      }
    },
    "toast": {
      "width": {
        "$type": "dimension",
        "$value": "{size.360}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      }
    }
  }
}
