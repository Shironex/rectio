{
  "surface": {
    "$type": "color",
    "canvas": {
      "$value": "{palette.paper.100}"
    },
    "default": {
      "$value": "{palette.paper.25}"
    },
    "raised": {
      "$value": "{palette.paper.0}"
    },
    "sunken": {
      "$value": "{palette.paper.75}"
    },
    "overlay": {
      "$value": "{palette.paper.0}"
    },
    "hover": {
      "$value": "{palette.paper.75}"
    },
    "selected": {
      "$value": "{palette.citron.25}"
    },
    "inset": {
      "$value": "{palette.paper.75}",
      "$description": "A band inside an overlay, such as a dialog footer. Sits above the overlay in dark mode, below it in light."
    },
    "placeholder": {
      "$value": "{palette.paper.200}",
      "$description": "A skeleton shape or the empty track of a bar, ring or gauge: one step off the surface it sits on, lighter in dark mode, darker in light."
    },
    "placeholder-shine": {
      "$value": "{palette.paper.25}",
      "$description": "The light that sweeps across a skeleton shape."
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{palette.ink.975}"
    },
    "muted": {
      "$value": "{palette.ink.700}"
    },
    "subtle": {
      "$value": "{palette.ink.650}"
    },
    "disabled": {
      "$value": "{palette.ink.500}"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{palette.paper.200}"
    },
    "strong": {
      "$value": "{palette.ink.500}"
    }
  },
  "accent": {
    "$type": "color",
    "default": {
      "$value": "{palette.ink.900}"
    },
    "hover": {
      "$value": "{palette.ink.800}"
    },
    "active": {
      "$value": "{palette.ink.950}"
    },
    "subtle": {
      "$value": "{palette.citron.100}"
    },
    "strong": {
      "$value": "{palette.ink.800}"
    },
    "contrast": {
      "$value": "{palette.citron.100}"
    },
    "$description": "Light ledger: green-black ink for actions, citron as the tint and the label on ink. Dark ledger inverts it: citron actions with ink labels."
  },
  "positive": {
    "$type": "color",
    "default": {
      "$value": "{palette.green.600}"
    },
    "subtle": {
      "$value": "{palette.green.50}"
    },
    "strong": {
      "$value": "{palette.green.700}"
    },
    "contrast": {
      "$value": "{palette.paper.0}"
    }
  },
  "negative": {
    "$type": "color",
    "default": {
      "$value": "{palette.red.600}"
    },
    "hover": {
      "$value": "{palette.red.700}"
    },
    "subtle": {
      "$value": "{palette.red.50}"
    },
    "strong": {
      "$value": "{palette.red.700}"
    },
    "contrast": {
      "$value": "{palette.paper.0}"
    }
  },
  "warning": {
    "$type": "color",
    "default": {
      "$value": "{palette.amber.400}"
    },
    "subtle": {
      "$value": "{palette.amber.50}"
    },
    "strong": {
      "$value": "{palette.amber.800}"
    },
    "contrast": {
      "$value": "{palette.ink.1000}"
    }
  },
  "info": {
    "$type": "color",
    "default": {
      "$value": "{palette.sky.600}"
    },
    "subtle": {
      "$value": "{palette.sky.50}"
    },
    "strong": {
      "$value": "{palette.sky.700}"
    },
    "contrast": {
      "$value": "{palette.paper.0}"
    }
  },
  "focus": {
    "$type": "color",
    "default": {
      "$value": "{palette.ink.900}"
    }
  },
  "scrim": {
    "$type": "color",
    "default": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.15, 0.012, 172],
        "alpha": 0.4
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.3, 0.012, 172],
            "alpha": 0.05
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 1,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.3, 0.012, 172],
            "alpha": 0.06
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.3, 0.012, 172],
            "alpha": 0.18
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 18,
            "unit": "px"
          },
          "blur": {
            "value": 40,
            "unit": "px"
          },
          "spread": {
            "value": -14,
            "unit": "px"
          }
        }
      ]
    }
  },
  "chart": {
    "$type": "color",
    "$description": "Data visualisation. Series and sequence marks hold 3:1 against the surface and stay apart under protan, deutan and tritan vision; a legend, label or table always names them too.",
    "series": {
      "1": {
        "$value": "{palette.ink.800}",
        "$description": "First series, such as inflow or actual."
      },
      "2": {
        "$value": "{palette.orange.500}",
        "$description": "Second series, such as outflow. Blue against orange stays apart for every common colour vision type."
      },
      "3": {
        "$value": "{palette.sky.600}",
        "$description": "A line over bars, such as net cash flow. Drawn with a halo so it reads over either series."
      }
    },
    "sequence": {
      "1": {
        "$value": "{palette.ink.500}",
        "$description": "Ordered steps, such as aging buckets from current to 90+ days. Step 1 is the calm state."
      },
      "2": {
        "$value": "{palette.heat.on-light-1}"
      },
      "3": {
        "$value": "{palette.heat.on-light-2}"
      },
      "4": {
        "$value": "{palette.heat.on-light-3}"
      },
      "5": {
        "$value": "{palette.heat.on-light-4}",
        "$description": "The most severe step, such as over 90 days past due: deepest in light mode, the most saturated in dark."
      }
    },
    "grid": {
      "$value": "{palette.paper.150}",
      "$description": "Gridlines: quiet, behind the data."
    },
    "axis": {
      "$value": "{palette.ink.650}",
      "$description": "Axis labels and ticks."
    },
    "baseline": {
      "$value": "{palette.ink.500}",
      "$description": "The zero line."
    },
    "reference": {
      "$value": "{palette.ink.400}",
      "$description": "A target or budget mark that the data is measured against."
    },
    "tooltip": {
      "$value": "{palette.paper.0}",
      "$description": "Tooltip background."
    },
    "tooltip-border": {
      "$value": "{palette.paper.200}"
    },
    "halo": {
      "$value": "{palette.paper.25}",
      "$description": "Outline under a line or label so it stays readable over marks; the surface colour."
    }
  },
  "identity": {
    "$type": "color",
    "$description": "Identity tints for avatars and initials: decorative, never a state. A name always picks the same tint. Each pair keeps strong text readable on its subtle fill.",
    "1": {
      "subtle": {
        "$value": "{palette.cobalt.100}"
      },
      "strong": {
        "$value": "{palette.cobalt.800}"
      }
    },
    "2": {
      "subtle": {
        "$value": "{palette.green.100}"
      },
      "strong": {
        "$value": "{palette.green.800}"
      }
    },
    "3": {
      "subtle": {
        "$value": "{palette.amber.100}"
      },
      "strong": {
        "$value": "{palette.amber.800}"
      }
    },
    "4": {
      "subtle": {
        "$value": "{palette.sky.100}"
      },
      "strong": {
        "$value": "{palette.sky.800}"
      }
    },
    "5": {
      "subtle": {
        "$value": "{palette.orange.100}"
      },
      "strong": {
        "$value": "{palette.orange.800}"
      }
    },
    "6": {
      "subtle": {
        "$value": "{palette.citron.100}"
      },
      "strong": {
        "$value": "{palette.citron.800}"
      }
    }
  },
  "code": {
    "$type": "color",
    "$description": "Syntax highlighting, read by a build-time highlighter through CSS variables (--rx-code-token-*). Every token colour holds 4.5:1 against the code background.",
    "background": {
      "$value": "{palette.paper.50}",
      "$description": "Code blocks and their tabs."
    },
    "foreground": {
      "$value": "{palette.ink.975}",
      "$description": "Code text without a token colour."
    },
    "highlight": {
      "$value": "{palette.citron.25}",
      "$description": "A highlighted line."
    },
    "inserted": {
      "$value": "{palette.green.50}",
      "$description": "A line a diff adds."
    },
    "deleted": {
      "$value": "{palette.red.50}",
      "$description": "A line a diff removes."
    },
    "inserted-mark": {
      "$value": "{palette.green.700}",
      "$description": "The + of an added line."
    },
    "deleted-mark": {
      "$value": "{palette.red.700}",
      "$description": "The - of a removed line."
    },
    "line-number": {
      "$value": "{palette.ink.600}",
      "$description": "Line numbers in the gutter."
    },
    "token": {
      "keyword": {
        "$value": "{palette.green.800}"
      },
      "string": {
        "$value": "{palette.orange.800}"
      },
      "function": {
        "$value": "{palette.sky.800}"
      },
      "constant": {
        "$value": "{palette.amber.800}"
      },
      "parameter": {
        "$value": "{palette.red.700}"
      },
      "comment": {
        "$value": "{palette.ink.600}"
      },
      "punctuation": {
        "$value": "{palette.ink.700}"
      },
      "string-expression": {
        "$value": "{palette.orange.800}"
      },
      "link": {
        "$value": "{palette.green.800}"
      }
    }
  }
}
