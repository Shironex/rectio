{
  "component": {
    "$description": "Component tokens (tier 3): knobs a theme may turn for one component. They alias semantic tokens by default.",
    "button": {
      "height": {
        "$type": "dimension",
        "sm": {
          "$value": "{control.height.sm}"
        },
        "md": {
          "$value": "{control.height.md}"
        },
        "lg": {
          "$value": "{control.height.lg}"
        }
      },
      "height-touch": {
        "$type": "dimension",
        "$value": "{control.height.touch}",
        "$description": "Button height and the hit area of small and icon buttons on touch screens."
      },
      "padding-x": {
        "$type": "dimension",
        "sm": {
          "$value": "{control.padding-x.sm}"
        },
        "md": {
          "$value": "{control.padding-x.md}"
        },
        "lg": {
          "$value": "{control.padding-x.lg}"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": "{font.tracking.normal}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "height-touch": {
        "$type": "dimension",
        "$value": "{control.height.touch}",
        "$description": "Input, AmountInput and Select trigger height on touch screens."
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{size.10}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "background": {
        "$type": "color",
        "$value": "{surface.default}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.strong}"
      }
    },
    "popover": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      },
      "width": {
        "$type": "dimension",
        "$value": "{size.480}"
      },
      "footer-background": {
        "$type": "color",
        "$value": "{surface.inset}"
      }
    },
    "money": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.numeric}"
      }
    },
    "table": {
      "row-height": {
        "$type": "dimension",
        "$value": "{control.height.lg}",
        "$description": "Minimum height of a body row. Follows density."
      },
      "row-height-touch": {
        "$type": "dimension",
        "$value": "{control.height.touch}",
        "$description": "Minimum height of header and body rows that hold a checkbox, on touch screens, so the 44px hit areas of checkboxes in adjacent rows never overlap. Never follows density."
      },
      "header-height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "cell-padding-x": {
        "$type": "dimension",
        "$value": "{control.padding-x.md}"
      },
      "header-background": {
        "$type": "color",
        "$value": "{surface.canvas}",
        "$description": "Behind a sticky header, so rows scroll under an opaque band. Match it to the surface the table sits on."
      },
      "row-selected": {
        "$type": "color",
        "$value": "{surface.selected}"
      }
    },
    "calendar": {
      "day-size": {
        "$type": "dimension",
        "$value": "{control.height.md}",
        "$description": "Width and height of a day button. Follows density."
      },
      "day-size-touch": {
        "$type": "dimension",
        "$value": "{control.height.touch}",
        "$description": "Day button size on touch screens, so each day is a 44px target."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.badge}"
      }
    },
    "toast": {
      "width": {
        "$type": "dimension",
        "$value": "{size.360}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      }
    },
    "emphasis": {
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.heading}",
        "$description": "The stressed phrase in a marketing headline, beside regular display text."
      },
      "style": {
        "$type": "other",
        "$value": "normal",
        "$description": "normal or italic. A theme whose display face carries no heavier weight stresses with italic instead."
      }
    },
    "sidebar": {
      "width": {
        "$type": "dimension",
        "$value": "{size.240}",
        "$description": "Expanded width of the app sidebar."
      },
      "width-collapsed": {
        "$type": "dimension",
        "$value": "{size.52}",
        "$description": "Width of the icon rail when the sidebar is collapsed."
      },
      "item-height": {
        "$type": "dimension",
        "$value": "{control.height.md}",
        "$description": "Height of a navigation item. Follows density."
      },
      "background": {
        "$type": "color",
        "$value": "{surface.canvas}",
        "$description": "Behind the sidebar. Match it to the page canvas for a quiet rail, or set surface.sunken to set it apart."
      },
      "item-active": {
        "$type": "color",
        "$value": "{surface.selected}",
        "$description": "Behind the item of the current page."
      }
    },
    "app-shell": {
      "header-height": {
        "$type": "dimension",
        "$value": "{size.56}",
        "$description": "Height of the top bar beside the sidebar."
      }
    },
    "sheet": {
      "width": {
        "$type": "dimension",
        "$value": "{size.400}",
        "$description": "Width of a sheet that slides in from the start or end edge: the medium size."
      },
      "width-sm": {
        "$type": "dimension",
        "$value": "{size.320}",
        "$description": "Width of a small side sheet, such as a short filter list."
      },
      "width-lg": {
        "$type": "dimension",
        "$value": "{size.560}",
        "$description": "Width of a large side sheet, such as a record with a conversation."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.panel}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.overlay}"
      }
    },
    "command": {
      "width": {
        "$type": "dimension",
        "$value": "{size.560}"
      },
      "list-height": {
        "$type": "dimension",
        "$value": "{size.360}",
        "$description": "Largest height of the result list before it scrolls."
      }
    },
    "tooltip": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      }
    },
    "hover-card": {
      "width": {
        "$type": "dimension",
        "$value": "{size.320}"
      }
    },
    "navigation-menu": {
      "panel-width": {
        "$type": "dimension",
        "$value": "{size.480}",
        "$description": "Width of a dropdown panel in the top navigation."
      }
    },
    "tabs": {
      "height": {
        "$type": "dimension",
        "$value": "{control.height.md}",
        "$description": "Height of a tab. Follows density."
      }
    }
  }
}
