{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typegen": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
