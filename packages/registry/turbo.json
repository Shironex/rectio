{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json",
        "$TURBO_ROOT$/packages/motion/src/**",
        "$TURBO_ROOT$/packages/motion/package.json",
        "$TURBO_ROOT$/packages/blocks/src/**",
        "$TURBO_ROOT$/packages/blocks/package.json",
        "$TURBO_ROOT$/templates/**",
        "!$TURBO_ROOT$/templates/*/.next/**",
        "!$TURBO_ROOT$/templates/*/out/**",
        "!$TURBO_ROOT$/templates/*/node_modules/**"
      ]
    }
  }
}
